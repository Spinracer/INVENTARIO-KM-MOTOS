# ============================================================================
# ARCHIVO DE CONFIGURACIÓN DE PRODUCCIÓN - INVENTARIO KM MOTOS
# ============================================================================
# IMPORTANTE: Cambia todos los valores marcados con "CAMBIAR_ESTO"
# NUNCA compartas este archivo públicamente, contiene credenciales sensibles
# ============================================================================

# --------------------------------------------
# CONFIGURACIÓN DOCKER
# --------------------------------------------
APP_VERSION=v7.0.13
APP_PORT=8000
APP_SSL_PORT=8443

# --------------------------------------------
# CONFIGURACIÓN BÁSICA DE LA APLICACIÓN
# --------------------------------------------
APP_ENV=production
APP_DEBUG=false

# CAMBIAR_ESTO: Generar con: docker compose run --rm app php artisan key:generate --show
APP_KEY=base64:CAMBIAR_ESTO_POR_CLAVE_GENERADA

# CAMBIAR_ESTO: URL donde estará accesible tu aplicación
APP_URL=http://tu-dominio.com
# Zona horaria: https://www.php.net/manual/es/timezones.php
APP_TIMEZONE='America/Bogota'
APP_LOCALE='es-ES'
MAX_RESULTS=500

# --------------------------------------------
# CONFIGURACIÓN DE ALMACENAMIENTO DE ARCHIVOS
# --------------------------------------------
# Utilizar almacenamiento local (en discos de 500TB)
PRIVATE_FILESYSTEM_DISK=local
PUBLIC_FILESYSTEM_DISK=local_public

# Para usar S3 (AWS, MinIO, etc) descomenta y configura:
#PRIVATE_FILESYSTEM_DISK=s3_private
#PUBLIC_FILESYSTEM_DISK=s3_public

# --------------------------------------------
# CONFIGURACIÓN DE BASE DE DATOS
# --------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_SOCKET=null
DB_PORT=3306

# CAMBIAR_ESTO: Credenciales de la base de datos
DB_DATABASE=snipeit_kmmotos
DB_USERNAME=snipeit_user
DB_PASSWORD=CAMBIAR_ESTO_PASSWORD_SEGURO_DB

# CAMBIAR_ESTO: Password del usuario root de MySQL
MYSQL_ROOT_PASSWORD=CAMBIAR_ESTO_PASSWORD_ROOT_MYSQL

DB_PREFIX=null
DB_DUMP_PATH='/usr/bin'
DB_DUMP_SKIP_SSL=false
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_SANITIZE_BY_DEFAULT=false

# --------------------------------------------
# CONFIGURACIÓN SSL DE BASE DE DATOS (OPCIONAL)
# --------------------------------------------
DB_SSL=false
DB_SSL_IS_PAAS=false
DB_SSL_KEY_PATH=null
DB_SSL_CERT_PATH=null
DB_SSL_CA_PATH=null
DB_SSL_CIPHER=null
DB_SSL_VERIFY_SERVER=null

# --------------------------------------------
# CONFIGURACIÓN DE SERVIDOR DE CORREO
# --------------------------------------------
# Configurar según tu proveedor de correo
MAIL_MAILER=smtp

# CAMBIAR_ESTO: Datos del servidor de correo
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@tudominio.com
MAIL_PASSWORD=CAMBIAR_ESTO_PASSWORD_CORREO
MAIL_FROM_ADDR=noreply@tudominio.com
MAIL_FROM_NAME='Inventario KM Motos'
MAIL_REPLYTO_ADDR=soporte@tudominio.com
MAIL_REPLYTO_NAME='Soporte KM Motos'
MAIL_AUTO_EMBED_METHOD='attachment'
MAIL_TLS_VERIFY_PEER=true

# --------------------------------------------
# LIBRERÍA DE IMÁGENES
# --------------------------------------------
# Opciones: gd o imagick
IMAGE_LIB=gd

# --------------------------------------------
# CONFIGURACIÓN DE BACKUPS
# --------------------------------------------
MAIL_BACKUP_NOTIFICATION_DRIVER=mail
MAIL_BACKUP_NOTIFICATION_ADDRESS=admin@tudominio.com
BACKUP_ENV=true
ALLOW_BACKUP_DELETE=false
ALLOW_DATA_PURGE=false
ALL_BACKUP_KEEP_DAYS=30
DAILY_BACKUP_KEEP_DAYS=60
WEEKLY_BACKUP_KEEP_WEEKS=24
MONTHLY_BACKUP_KEEP_MONTHS=12
YEARLY_BACKUP_KEEP_YEARS=5
# En megabytes - Con discos de 500TB esto puede ser mucho mayor
BACKUP_PURGE_OLDEST_AT_MEGS=500000

# --------------------------------------------
# CONFIGURACIÓN DE SESIONES
# --------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=12000
EXPIRE_ON_CLOSE=false
ENCRYPT=false
COOKIE_NAME=snipeit_kmmotos_session
PASSPORT_COOKIE_NAME='snipeit_kmmotos_passport'
COOKIE_DOMAIN=null
SECURE_COOKIES=true
API_TOKEN_EXPIRATION_YEARS=15
BS_TABLE_STORAGE=localStorage
BS_TABLE_DEEPLINK=true

# --------------------------------------------
# CONFIGURACIÓN DE SEGURIDAD
# --------------------------------------------
# CAMBIAR_ESTO: IPs de proxies confiables (si usas nginx/apache delante)
APP_TRUSTED_PROXIES=172.25.0.0/16
ALLOW_IFRAMING=false
REFERRER_POLICY=same-origin
ENABLE_CSP=true
ADDITIONAL_CSP_URLS=null
CORS_ALLOWED_ORIGINS=null
ENABLE_HSTS=true

# --------------------------------------------
# CONFIGURACIÓN DE CACHE
# --------------------------------------------
CACHE_DRIVER=redis
QUEUE_DRIVER=redis
CACHE_PREFIX=snipeit_kmmotos

# --------------------------------------------
# CONFIGURACIÓN DE REDIS
# --------------------------------------------
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --------------------------------------------
# CONFIGURACIÓN S3 PÚBLICA (OPCIONAL)
# --------------------------------------------
# Descomenta y configura si usas S3 o almacenamiento compatible
#PUBLIC_AWS_SECRET_ACCESS_KEY=null
#PUBLIC_AWS_ACCESS_KEY_ID=null
#PUBLIC_AWS_DEFAULT_REGION=us-east-1
#PUBLIC_AWS_BUCKET=kmmotos-public
#PUBLIC_AWS_URL=null
#PUBLIC_AWS_ENDPOINT=null
#PUBLIC_AWS_PATH_STYLE=false
#PUBLIC_AWS_BUCKET_ROOT=null

# --------------------------------------------
# CONFIGURACIÓN S3 PRIVADA (OPCIONAL)
# --------------------------------------------
#PRIVATE_AWS_ACCESS_KEY_ID=null
#PRIVATE_AWS_SECRET_ACCESS_KEY=null
#PRIVATE_AWS_DEFAULT_REGION=us-east-1
#PRIVATE_AWS_BUCKET=kmmotos-private
#PRIVATE_AWS_URL=null
#PRIVATE_AWS_ENDPOINT=null
#PRIVATE_AWS_PATH_STYLE=false
#PRIVATE_AWS_BUCKET_ROOT=null

# --------------------------------------------
# LIMITACIÓN DE INTENTOS DE LOGIN
# --------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=60
LOGIN_AUTOCOMPLETE=false

# --------------------------------------------
# CONFIGURACIÓN DE RECUPERACIÓN DE CONTRASEÑA
# --------------------------------------------
RESET_PASSWORD_LINK_EXPIRES=60
PASSWORD_CONFIRM_TIMEOUT=10800
PASSWORD_RESET_MAX_ATTEMPTS_PER_MIN=5
INVITE_PASSWORD_LINK_EXPIRES=1500

# --------------------------------------------
# CONFIGURACIÓN MISCELÁNEA
# --------------------------------------------
LOG_CHANNEL=daily
LOG_DEPRECATIONS=false
LOG_MAX_DAYS=30
APP_LOCKED=false
APP_CIPHER=AES-256-CBC
APP_FORCE_TLS=true
APP_ALLOW_INSECURE_HOSTS=false

# API de Google Maps (opcional)
GOOGLE_MAPS_API=

# Límites de LDAP
LDAP_MEM_LIM=500M
LDAP_TIME_LIM=600

# Límites de tiempo de ejecución
BACKUP_TIME_LIMIT=3600
IMPORT_TIME_LIMIT=3600
IMPORT_MEMORY_LIMIT=2048M
REPORT_TIME_LIMIT=12000

# API throttling
API_THROTTLE_PER_MINUTE=120

# Seguridad para CSV
CSV_ESCAPE_FORMULAS=true

# Livewire
LIVEWIRE_URL_PREFIX=null
MAX_UNPAGINATED=5000

# --------------------------------------------
# CONFIGURACIÓN SAML (OPCIONAL)
# --------------------------------------------
REQUIRE_SAML=false
SAML_KEY_SIZE=2048

# --------------------------------------------
# CONFIGURACIÓN DE HASHING
# --------------------------------------------
HASHING_DRIVER='bcrypt'
BCRYPT_ROUNDS=12
ARGON_MEMORY=2048
ARGON_THREADS=4
ARGON_TIME=4

# --------------------------------------------
# CONFIGURACIÓN SCIM (OPCIONAL)
# --------------------------------------------
SCIM_TRACE=false
SCIM_STANDARDS_COMPLIANCE=false

# --------------------------------------------
# LÍMITES DE CARGA PHP (OPCIONAL)
# --------------------------------------------
# Descomenta para cambiar los límites de carga de archivos
PHP_UPLOAD_LIMIT=100M
PHP_POST_MAX_SIZE=100M
PHP_UPLOAD_MAX_FILESIZE=100M
PHP_MEMORY_LIMIT=512M
